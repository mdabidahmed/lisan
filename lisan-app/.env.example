# Public application metadata (all VITE_* vars are exposed to the browser bundle — never put secrets here).
VITE_APP_NAME="Lisan"
VITE_APP_URL="https://lisan.app"

# API layer. Leave the mode as "mock" to use the bundled in-memory API.
# Switch to "http" and set the base URL once a real backend exists.
VITE_API_MODE="mock"
VITE_API_BASE_URL="/api"

# Simulated latency (ms) for the mock client, useful for exercising loading states.
VITE_API_MOCK_LATENCY="180"

# Analytics sink. "noop" disables all event delivery.
VITE_ANALYTICS_PROVIDER="noop"
